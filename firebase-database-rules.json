{
  "rules": {
    ".read": false,
    ".write": false,

    "owner": {
      ".read": true,
      ".write": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists() && ((!data.exists() && newData.child('uid').val() == auth.uid) || data.child('uid').val() == auth.uid)"
    },

    "admins": {
      ".read": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists() && (root.child('owner/uid').val() == auth.uid || root.child('admins').child(auth.uid).exists())",
      "$uid": {
        ".read": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists() && (auth.uid == $uid || root.child('owner/uid').val() == auth.uid)",
        ".write": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists() && ((root.child('owner/uid').val() == auth.uid) || (auth.uid == $uid && data.exists() && newData.exists() && newData.child('email').val() == data.child('email').val() && newData.child('role').val() == data.child('role').val()))"
      }
    },

    "students": {
      ".read": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists() && (auth.uid == $uid || root.child('owner/uid').val() == auth.uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists() && ((root.child('owner/uid').val() == auth.uid) || (root.child('admins').child(auth.uid).exists() && data.exists() && newData.exists() && newData.child('name').val() == data.child('name').val() && newData.child('email').val() == data.child('email').val() && newData.child('phone').val() == data.child('phone').val() && newData.child('groupId').val() == data.child('groupId').val() && newData.child('schoolId').val() == data.child('schoolId').val() && newData.child('status').val() != data.child('status').val() && (newData.child('status').val() == 'active' || newData.child('status').val() == 'banned')) || (auth.uid == $uid && ((!data.exists() && newData.exists() && newData.child('status').val() == 'pending') || (data.exists() && newData.exists() && newData.child('status').val() == data.child('status').val() && newData.child('uid').val() == data.child('uid').val() && newData.child('groupId').val() == data.child('groupId').val() && newData.child('schoolId').val() == data.child('schoolId').val()))))"
      }
    },

    "schools": {
      ".read": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists()",
      "$schoolId": {
        ".write": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists() && root.child('owner/uid').val() == auth.uid"
      }
    },

    "groups": {
      ".read": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists()",
      "$groupId": {
        ".write": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists() && root.child('owner/uid').val() == auth.uid"
      }
    },

    "subjects": {
      ".read": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists()",
      "$subjectId": {
        ".write": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists() && root.child('owner/uid').val() == auth.uid"
      }
    },

    "grades": {
      ".read": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists() && (root.child('owner/uid').val() == auth.uid || root.child('admins').child(auth.uid).exists())",
      "$studentUid": {
        ".read": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists() && (auth.uid == $studentUid || root.child('owner/uid').val() == auth.uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists() && root.child('owner/uid').val() == auth.uid"
      }
    },

    "attendance": {
      ".read": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists()",
      "$groupId": {
        "$date": {
          "$studentUid": {
            ".write": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists() && (root.child('owner/uid').val() == auth.uid || root.child('groups').child($groupId).child('adminIds').child(auth.uid).val() == true)"
          }
        }
      }
    },

    "notifications": {
      ".read": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists()",
      "$notificationId": {
        ".write": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists() && (root.child('owner/uid').val() == auth.uid || root.child('admins').child(auth.uid).exists())"
      }
    },

    "notifRead": {
      "$uid": {
        ".read": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists() && auth.uid == $uid",
        ".write": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists() && auth.uid == $uid"
      }
    },

    "ownerExperience": {
      ".read": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists() && root.child('owner/uid').val() == auth.uid",
      ".write": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists() && root.child('owner/uid').val() == auth.uid"
    },

    "ownerExcelReports": {
      ".read": "auth != null && !root.child('deletedAccounts').child(auth.uid).exists() && root.child('owner/uid').val() == auth.uid",
      ".write": false
    },

    "deletedAccounts": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('owner/uid').val() == auth.uid)",
        ".write": "auth != null && root.child('owner/uid').val() == auth.uid"
      }
    }
  }
}